# Frontend Environment Variables
# Copy to .env and fill in values before running

# Base URL of the FastAPI backend.
# In development this is overridden by vite.config.js proxy,
# but keeping it here makes production builds straightforward.
VITE_API_URL=http://localhost:8000/api/v1

# App display name (used in <title> and sidebar branding)
VITE_APP_NAME=Retail BI System
