# ─────────────────────────────────────────────────────────────────────────────
# Copy this to backend/.env and fill in your values before running locally.
# NEVER commit the actual .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_bi

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_32_byte_random_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── LLM (Gemini via CrewAI) ───────────────────────────────────────────────────
LLM_MODEL=gemini/gemini-3.1-flash-lite
LLM_API_KEY=your_google_gemini_api_key_here

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=1.0.0
